{
    // 构建走仓库根目录的 build.ps1:它自己收集 src 下所有 .cpp。
    // 拆分多文件后不能再编译"当前活动文件",那样链接不到其它编译单元的符号。
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build PYS (all sources)",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/build.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": " 编译器：g++，源文件由 build.ps1 自动收集"
        }
    ]
}
